# ─────────────────────────────────────────────────────────────────
# A&O Holdings — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Site (public) ─────────────────────────────────────────────────
# The canonical domain, no trailing slash.
# Used in metadata, sitemap, robots, JSON-LD and the vercel.app redirect.
NEXT_PUBLIC_SITE_URL=https://aoholdings.com

# ── Calendly booking widget (public) ──────────────────────────────
# Full Calendly event URL. If unset, a fallback button appears instead.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/ao-holdings/intro

# ── Google Search Console (public) ────────────────────────────────
# Value of the <meta name="google-site-verification"> tag.
# Obtain from: https://search.google.com/search-console
# Leave blank to use DNS TXT verification instead (see LAUNCH_CHECKLIST.md).
NEXT_PUBLIC_GSC_VERIFICATION=

# ── GA4 (public) ──────────────────────────────────────────────────
# Measurement ID from Google Analytics 4 (e.g. G-XXXXXXXXXX).
# Currently unused in code — add GA4 script when you enable it.
NEXT_PUBLIC_GA_ID=

# ── Email delivery (SERVER-ONLY — never prefix with NEXT_PUBLIC_) ─
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of founder email addresses.
# Email is sent to ALL of these on every contact form submission.
# NEVER expose in client JS, HTML, JSON-LD or API responses.
CONTACT_TO_EMAILS=founder1@example.com,founder2@example.com

# ── Rate limiting — Upstash Redis (SERVER-ONLY) ────────────────────
# Leave blank to fall back to in-memory rate limiting (fine for low traffic).
# Get free credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Telegram callback alerts (SERVER-ONLY, optional) ─────────────
# Required only if you add the /api/callback route.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Twilio SMS (SERVER-ONLY, optional) ────────────────────────────
# For future WhatsApp/SMS callback alerts. NOT enabled by default.
# Note: SMS to India requires DLT registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FOUNDER_PHONE=
